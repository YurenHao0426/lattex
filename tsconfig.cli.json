{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "outDir": "./out/cli",
    "rootDir": "./src",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["node"],
    "declaration": true,
    "declarationDir": "./out/cli/types"
  },
  "include": [
    "src/cli/**/*",
    "src/main/overleafProtocol.ts"
  ]
}
